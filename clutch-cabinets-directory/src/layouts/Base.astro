---
import site from '../config/site.json';
interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const fullTitle = title === site.siteName ? title : `${title} | ${site.siteName}`;
const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
const c = site.colors;
const path = Astro.url.pathname.replace(/\.html$/, '');
const nav = [
  { href: '/directory', label: 'Directory' },
  { href: '/commercial', label: 'Commercial' },
  { href: '/quote', label: 'Request a Quote' },
  { href: '/about', label: 'About' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style set:html={`:root{--primary:${c.primary};--primary-dark:${c.primaryDark};--accent:${c.accent};--ink:${c.ink};--muted:${c.muted};--surface:${c.surface};--line:${c.line};}`}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label={`${site.siteName} home`}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="5" width="26" height="22" rx="2" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M16 5v22M3 16h26" stroke="currentColor" stroke-width="2.5"/><circle cx="12.5" cy="11" r="1.4" fill="currentColor"/><circle cx="19.5" cy="11" r="1.4" fill="currentColor"/></svg>
          <span>{site.siteName}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-brand">{site.siteName}</p>
          <p>Custom cabinet shops serving {site.region}.</p>
        </div>
        <div>
          <p class="disclosure"><strong>Disclosure:</strong> This directory is operated by <a href={site.operatorUrl}>{site.operatorName}</a>. Our own listing is marked "Operator." <a href="/about">How the directory works</a>.</p>
          <p>Shop owner? <a href="/request-update">Request a listing update</a> · <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
          <p class="small">© {year} {site.operatorName}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color: var(--ink); background: #fff; line-height: 1.55; font-size: 1.0625rem; }
  img { max-width: 100%; height: auto; }
  a { color: var(--primary); text-underline-offset: 2px; }
  a:hover { color: var(--primary-dark); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 .5em; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); }
  h2 { font-size: clamp(1.4rem, 3vw, 1.85rem); }
  h3 { font-size: 1.15rem; }
  p { margin: 0 0 1em; }
  .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .section { padding: 48px 0; }
  .section.alt { background: var(--surface); border-block: 1px solid var(--line); }
  .muted { color: var(--muted); }
  .small { font-size: .875rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: #fff; padding: 8px 12px; z-index: 10; }

  .site-header { border-bottom: 1px solid var(--line); background: #fff; }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-block: 12px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; color: var(--ink); text-decoration: none; font-size: 1.1rem; }
  .brand svg { color: var(--primary); }
  .site-header ul { display: flex; flex-wrap: wrap; gap: 4px 18px; list-style: none; margin: 0; padding: 0; }
  .site-header nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: .95rem; padding: 6px 0; display: inline-block; border-bottom: 2px solid transparent; }
  .site-header nav a[aria-current="page"], .site-header nav a:hover { border-bottom-color: var(--primary); }

  .site-footer { background: var(--ink); color: #e8e4dd; margin-top: 0; padding: 36px 0; font-size: .95rem; }
  .site-footer a { color: #f3c77a; }
  .footer-inner { display: grid; gap: 24px; }
  @media (min-width: 760px) { .footer-inner { grid-template-columns: 1fr 2fr; } }
  .footer-brand { font-weight: 800; font-size: 1.1rem; color: #fff; }

  .btn { display: inline-block; background: var(--primary); color: #fff; border: 2px solid var(--primary); padding: 11px 20px; border-radius: 6px; font-weight: 700; text-decoration: none; cursor: pointer; font-size: 1rem; }
  .btn:hover { background: var(--primary-dark); border-color: var(--primary-dark); color: #fff; }
  .btn.ghost { background: transparent; color: var(--primary); }
  .btn.ghost:hover { background: var(--primary); color: #fff; }

  .badge { display: inline-block; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding: 2px 8px; border-radius: 4px; background: var(--ink); color: #fff; vertical-align: middle; }
  .badge.featured { background: var(--accent); color: var(--ink); }
  .tag { display: inline-block; font-size: .8rem; padding: 2px 8px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }

  label { font-weight: 600; display: block; margin-bottom: 4px; }
  input, select, textarea { font: inherit; width: 100%; padding: 10px 12px; border: 1px solid #8f8a82; border-radius: 6px; background: #fff; color: var(--ink); }
  textarea { min-height: 110px; }
  .field { margin-bottom: 16px; }
  .hint { font-size: .875rem; color: var(--muted); margin-top: 4px; }
  .callout { border-left: 4px solid var(--accent); background: var(--surface); padding: 14px 16px; border-radius: 0 6px 6px 0; }
  table { border-collapse: collapse; width: 100%; font-size: .95rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--surface); }
  .table-scroll { overflow-x: auto; }
</style>
