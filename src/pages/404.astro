---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page doesn't exist." noindex>
  <section class="section">
    <div class="wrap" style="max-width:720px">
      <h1>Page not found</h1>
      <p>That page doesn't exist, or the shop listing may have moved.</p>
      <p><a class="btn" href="/directory">Browse the directory</a></p>
    </div>
  </section>
</Base>
