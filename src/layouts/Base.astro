---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/ibm-plex-sans/400';
import '@fontsource/ibm-plex-sans/600';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';
import site from '../config/site.json';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const fullTitle = title === site.siteName ? title : `${title} | ${site.siteName}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site.siteUrl).href;
const c = site.colors;
const path = Astro.url.pathname.replace(/\.html$/, '');
const hideFromSearch = noindex || site.previewNoindex;
const nav = [
  { href: '/directory', label: 'Directory' },
  { href: '/commercial', label: 'Commercial' },
  { href: '/quote', label: 'Request a Quote' },
  { href: '/about', label: 'About' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={c.walnut} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style set:html={`:root{--walnut:${c.walnut};--steel:${c.steel};--maple:${c.maple};--sawdust:${c.sawdust};--orange:${c.orange};--orange-ink:${c.orangeInk};--graphite:${c.graphite};--graphite-ink:${c.graphiteInk};}`}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">
          <svg class="brand-mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <rect x="2" y="2" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M17 2v30M2 13h30" stroke="currentColor" stroke-width="2"/>
            <path d="M8 21h4M22 21h4" stroke="var(--orange)" stroke-width="2.5"/>
          </svg>
          <span class="brand-text">{site.siteName}<span class="brand-sub">Custom cabinet shops · {site.region}</span></span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="title-block" aria-label="Directory information">
          <div class="tb-cell tb-name"><span class="ann">Project</span>{site.siteName}</div>
          <div class="tb-cell"><span class="ann">Region</span>{site.region}</div>
          <div class="tb-cell"><span class="ann">Operated by</span><a href={site.operatorUrl}>{site.operatorName}</a></div>
          <div class="tb-cell"><span class="ann">Sheet</span>{year}</div>
        </div>
        <div class="footer-copy">
          <p class="disclosure"><strong>This directory is operated by {site.operatorName}.</strong> Our own listing carries an “Operator” label, and commercial rankings follow <a href="/commercial#how-ranked">published criteria</a>. <a href="/about">How the directory works</a>.</p>
          <p>Shop owner? <a href="/request-update">Request a listing update</a> · <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--walnut); color: var(--maple); border-bottom: 3px solid var(--steel); }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 28px; padding-block: 12px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--maple); text-decoration: none; }
  .brand-mark { color: var(--maple); flex: none; }
  .brand-text { font-family: var(--display); font-weight: 800; font-size: 1.45rem; line-height: 1; letter-spacing: .01em; display: flex; flex-direction: column; }
  .brand-sub { font-family: var(--mono); font-weight: 500; font-size: .72rem; letter-spacing: .02em; color: #d8c8ad; margin-top: 4px; }
  .site-header ul { display: flex; flex-wrap: wrap; gap: 2px 22px; list-style: none; margin: 0; padding: 0; }
  .site-header nav a { color: var(--maple); text-decoration: none; font-weight: 600; font-size: .98rem; display: inline-block; padding: 8px 0; border-bottom: 3px solid transparent; }
  .site-header nav a:hover { border-bottom-color: #8a7560; color: #fff; }
  .site-header nav a[aria-current='page'] { border-bottom-color: var(--orange); color: #fff; }
  .site-footer { background: var(--walnut); color: var(--maple); padding: 40px 0 44px; margin-top: 0; }
  .footer-inner { display: grid; gap: 28px; }
  @media (min-width: 860px) { .footer-inner { grid-template-columns: 1.2fr 1fr; align-items: start; } }
  .title-block { display: grid; grid-template-columns: 1fr 1fr; border: 1.5px solid #9c8466; }
  .tb-cell { padding: 10px 12px; border-right: 1.5px solid #9c8466; border-bottom: 1.5px solid #9c8466; font-weight: 600; overflow-wrap: anywhere; }
  .tb-cell:nth-child(2n) { border-right: 0; }
  .tb-cell:nth-last-child(-n+2) { border-bottom: 0; }
  .tb-name { font-family: var(--display); font-weight: 800; font-size: 1.3rem; }
  .title-block .ann { display: block; color: #d8c8ad; margin-bottom: 2px; }
  .site-footer a { color: #ffd2bd; }
  .footer-copy p { max-width: 60ch; }
  .disclosure { font-size: 1.02rem; }
</style>
